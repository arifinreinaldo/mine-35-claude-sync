{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(python3 -c \"import sys,json;d=json.load(sys.stdin);print((d.get('tool_input') or {}).get('file_path') or (d.get('tool_response') or {}).get('filePath') or '')\"); case \"$f\" in *package-lock.json|*.lock) ;; *.dart) command -v dart >/dev/null 2>&1 && dart format \"$f\" >/dev/null ;; *.php) [ -f vendor/bin/pint ] && php vendor/bin/pint --quiet \"$f\" ;; *.js|*.jsx|*.ts|*.tsx|*.json|*.yaml|*.yml|*.css|*.html) command -v prettier >/dev/null 2>&1 && prettier --write --log-level silent \"$f\" ;; esac 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-code-plugins": true,
    "stripe@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "code-review@claude-code-plugins": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "trading-ideas@claude-equity-research-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "alirezarezvani/claude-skills"
      }
    },
    "claude-equity-research-marketplace": {
      "source": {
        "source": "github",
        "repo": "quant-sentiment-ai/claude-equity-research"
      }
    }
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
