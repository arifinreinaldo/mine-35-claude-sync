# Deterministic line endings across Windows / macOS / Linux.
# Don't rely on per-machine core.autocrlf — normalize all text to LF in the repo
# and check out LF on every platform. bash never sees a stray CR; PowerShell 5.1
# and 7 both run LF .ps1 scripts fine.
* text=auto eol=lf

# Binary assets: never apply text / eol / charset conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pptx binary
*.zip  binary
